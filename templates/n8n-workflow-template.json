      },
      "name": "Read Calendar",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsApi": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets Service Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter and prepare LinkedIn posts for automation\nconst items = [];\nconst headers = $input.first().json[0];\n\n// Find column indices\nconst platformIndex = headers.indexOf('Platform');\nconst statusIndex = headers.indexOf('Status');\nconst automationStatusIndex = headers.indexOf('Automation Status');\nconst postContentIndex = headers.indexOf('Post Content');\nconst dateIndex = headers.indexOf('Date');\nconst timeIndex = headers.indexOf('Time');\n\n// Process each row (skip header)\nfor (let i = 1; i < $input.first().json.length; i++) {\n  const row = $input.first().json[i];\n  \n  // Check if this is a LinkedIn post that needs processing\n  if (row[platformIndex] === 'LinkedIn' && \n      row[statusIndex] === 'Approved' && \n      (row[automationStatusIndex] === 'Pending' || row[automationStatusIndex] === '')) {\n    \n    // Check if it's time to post\n    const scheduledDateTime = new Date(`${row[dateIndex]} ${row[timeIndex]}`);\n    const now = new Date();\n    \n    if (scheduledDateTime <= now) {\n      items.push({\n        json: {\n          content: row[postContentIndex],\n          scheduledTime: scheduledDateTime,\n          rowIndex: i + 1, // +1 because spreadsheet rows are 1-indexed\n          originalRow: row,\n          headers: headers\n        }\n      });\n    }\n  }\n}\n\nreturn items;"
      },
      "name": "Filter LinkedIn Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c5e9d4b5-e5ad-4c77-8c5d-4a7c2c5e9d4b",
              "leftValue": "={{ $json.content }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Validate Content",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
